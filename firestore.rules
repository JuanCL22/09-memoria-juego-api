rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regla 9.2: Acceso exclusivo desde la API mediante Firebase Admin SDK.
    // Se niega toda lectura y escritura directa desde clientes móviles o web.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
